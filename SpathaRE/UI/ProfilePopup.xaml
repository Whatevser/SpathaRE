<Window x:Class="SpathaRE.UI.ProfilePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpathaRE" Width="320" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <Border Background="{StaticResource Surface}" CornerRadius="12"
            BorderBrush="{StaticResource LineHi}" BorderThickness="1" Padding="18,16" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- one block per connected mouse, built in code -->
            <StackPanel x:Name="Devices"/>

            <Button x:Name="OpenSettings" Margin="0,4,0,0" HorizontalAlignment="Stretch" Style="{StaticResource AccentButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                    <TextBlock Text="Open settings"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
