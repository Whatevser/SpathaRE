<Window x:Class="SpathaRE.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SpathaRE.UI"
        Title="SpathaRE" Icon="pack://application:,,,/Assets/SpathaRE.ico" Width="1200" Height="780" MinWidth="1000" MinHeight="640"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ navigation rail ============ -->
        <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,24,20,26">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SPATHA" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="RE" FontSize="17" FontWeight="Light" Foreground="{StaticResource Fg}"/>
                    </StackPanel>
                    <TextBlock Text="ROG Spatha · Spatha X" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
                    <Button x:Name="RescanButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            ToolTip="Search for mice again">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                            <TextBlock Text="Re-scan devices"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ResyncButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            ToolTip="Read every setting from the mouse again">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                            <TextBlock Text="Reload from mouse"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock x:Name="DeviceListCaption" Text="MICE" Style="{StaticResource Caption}" Margin="22,0,0,6"/>
                    <StackPanel x:Name="DeviceList"/>
                </StackPanel>

                <StackPanel x:Name="Nav">
                    <TextBlock Text="SETTINGS" Style="{StaticResource Caption}" Margin="22,0,0,6"/>
                    <RadioButton x:Name="NavButtons" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True" Tag="Buttons">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE962;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="28"/>
                            <TextBlock Text="Buttons"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Performance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="28"/>
                            <TextBlock Text="Performance"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Lighting">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="28"/>
                            <TextBlock Text="Lighting"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Power">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE83F;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="28"/>
                            <TextBlock Text="Power"/>
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Text="APP" Style="{StaticResource Caption}" Margin="22,14,0,6"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Hotkeys">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="28"/>
                            <TextBlock Text="Hotkeys"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ main area ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Margin="30,22,30,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DeviceName" Text="Looking for your mouse…" Style="{StaticResource H1}"/>
                    <WrapPanel x:Name="Chips" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="ExportButton" Style="{StaticResource GhostButton}" Padding="6,2" Margin="6,0,0,0"
                                    ToolTip="Save button settings and DPI to a file">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" FontSize="12"/>
                                    <TextBlock Text="Export" FontSize="11.5"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ImportButton" Style="{StaticResource GhostButton}" Padding="6,2" Margin="2,0,0,0"
                                    ToolTip="Load button settings and DPI from a file (also from the other Spatha model)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" FontSize="12"/>
                                    <TextBlock Text="Import" FontSize="11.5"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="ONBOARD PROFILE" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <WrapPanel x:Name="ProfileStrip" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- pages -->
            <Grid Grid.Row="1" Margin="30,0,30,0">
                <!-- read-only / info banner -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="Banner" Visibility="Collapsed" Background="{StaticResource AccentSoft}"
                        BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,12">
                    <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontSize="12.5"/>
                </Border>

                <Grid Grid.Row="1" x:Name="Pages">
                    <!-- Buttons -->
                    <Grid x:Name="ButtonsPage">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Margin="0,0,16,14">
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="4,6,0,0"
                                       Text="Click a button on the mouse or its callout to change what it does. Changes are saved to the active onboard profile. Hover a profile number at the top to see, in red, which buttons switch to it on the mouse."/>
                            <ui:SlotMap x:Name="Map" VerticalAlignment="Top"/>
                        </DockPanel>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="SELECTED BUTTON" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="SlotTitle" Text="Pick a button" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Currently  " Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="SlotCurrent" Text="—" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <WrapPanel x:Name="CategoryBar" Margin="0,0,0,6"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <!-- shortcut recorder (mice that send combos natively) -->
                                    <!-- custom combo, original Spatha: the mouse sends it natively -->
                                    <Border x:Name="ShortcutPanel" Visibility="Collapsed" Background="{StaticResource SurfaceAlt}"
                                            BorderBrush="{StaticResource LineHi}" BorderThickness="1"
                                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="CUSTOM COMBO" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,8"
                                                       Text="1. Click the box.  2. Press the keys together, e.g. Ctrl+Shift+Esc.  3. Assign. Up to 3 keys plus Ctrl / Shift / Alt / Win; the mouse sends it by itself."/>
                                            <TextBox x:Name="ShortcutBox" IsReadOnly="True" Text="Click here, then press the keys"
                                                     Cursor="Hand" FontFamily="Consolas" FontSize="14"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button x:Name="ShortcutAssign" Content="Assign to this button" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                                                <Button x:Name="ShortcutClear" Content="Clear"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- combo editor, Spatha X: the mouse sends F13-F24, SpathaRE types the keys -->
                                    <Border x:Name="ComboPanel" Visibility="Collapsed" Background="{StaticResource SurfaceAlt}"
                                            BorderBrush="{StaticResource LineHi}" BorderThickness="1"
                                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="ComboTitle" Text="EDIT COMBO" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="ComboHelp" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,8"/>
                                            <TextBox x:Name="ComboRecorder" IsReadOnly="True" Cursor="Hand" FontFamily="Consolas" FontSize="14"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button x:Name="ComboSave" Content="Save keys" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                                                <Button x:Name="ComboDefault" Content="Reset to default"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ComboStatus" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="ResetBindings" Content="Reset all buttons to default" HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <DockPanel>
                                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" ToolTip="Filter"/>
                                    <ListBox x:Name="ActionList"/>
                                </DockPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="PerformancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PerformancePanel" Margin="0,0,10,10"/>
                    </ScrollViewer>
                    <ScrollViewer x:Name="LightingPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LightingPanel" Margin="0,0,10,10"/>
                    </ScrollViewer>
                    <ScrollViewer x:Name="PowerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PowerPanel" Margin="0,0,10,10"/>
                    </ScrollViewer>
                    <ScrollViewer x:Name="HotkeysPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HotkeysPanel" Margin="0,0,10,10"/>
                    </ScrollViewer>

                    <!-- no device -->
                    <Border x:Name="EmptyState" Visibility="Collapsed" Background="{StaticResource Bg}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="&#xE962;" FontFamily="{StaticResource IconFont}" FontSize="44"
                                       Foreground="{StaticResource FgFaint}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyTitle" Text="No supported mouse found" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                            <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" TextAlignment="Center"
                                       Text="Plug in a ROG Spatha or Spatha X (cable or dock) and move it to wake it up. Close Armoury Crate so the two programs don't talk to the mouse at the same time."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- status line -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="30,8">
                <DockPanel>
                    <TextBlock x:Name="BusyText" DockPanel.Dock="Right" Style="{StaticResource Muted}" Text=""/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Text="Ready"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
