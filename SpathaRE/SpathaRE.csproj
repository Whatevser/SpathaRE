<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is on for NotifyIcon and System.Drawing (AsusMouse uses Color). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.1</Version>
    <Product>SpathaRE</Product>
    <ApplicationIcon>Assets\SpathaRE.ico</ApplicationIcon>
    <AssemblyName>SpathaRE</AssemblyName>
    <RootNamespace>SpathaRE</RootNamespace>
    <DebugType>embedded</DebugType>
    <!-- WFO0003 / WFAC010: the WinForms analyzers want high-DPI mode set in code instead
         of app.manifest. WPF draws everything here and reads PerMonitorV2 from the
         manifest, so the manifest stays and the warnings are silenced. -->
    <NoWarn>$(NoWarn);WFO0003;WFAC010</NoWarn>

    <!-- Native x64 and ARM64 builds; nothing in the app is architecture-specific. -->
    <Platforms>ARM64;x64</Platforms>
    <Platform>ARM64</Platform>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <!-- Small single-file exe that uses the installed .NET 10 Desktop Runtime, like
         G-Helper. When the runtime is missing, the .NET launcher itself says so and
         offers the download page. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds System.Windows.Forms + System.Drawing as implicit
         global usings. System.Windows.Forms.Application then collides with
         System.Windows.Application in every WPF file. Drop it; the `Forms`
         alias covers the handful of WinForms types we actually use.
         System.Drawing goes too (its Color clashes with WPF's); files that need it,
         like AsusMouse.cs, import it themselves. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />

    <!-- The WinForms+WPF implicit-using set omits System.IO, which the HID code
         from G-Helper needs for IOException. Add it globally rather than editing
         four files. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Button-map artwork (line renders of the Spatha, top and left side). -->
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\SpathaRE.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only third-party dependency. Fully managed; P/Invokes hid.dll and
         setupapi.dll, no native payload, so it loads fine under ARM64. -->
    <PackageReference Include="HidSharpCore" Version="1.3.0" />
  </ItemGroup>

</Project>
