<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is on for NotifyIcon and System.Drawing (AsusMouse uses Color). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SpathaRE.ico</ApplicationIcon>
    <AssemblyName>SpathaRE</AssemblyName>
    <RootNamespace>SpathaRE</RootNamespace>
    <DebugType>embedded</DebugType>
    <!-- WFAC010: the WinForms analyzer wants DPI configured via ApplicationHighDpiMode.
         That is WinForms-only advice; this is a WPF app, and WPF reads PerMonitorV2
         from the manifest. Keep the manifest, silence the analyzer. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>

    <!-- ARM64 native. This is the whole point: G-Helper pins x64 because of
         nvapi64.dll and the Ryzen SMU / Intel MSR blobs. None of that is here. -->
    <Platforms>ARM64;x64</Platforms>
    <Platform>ARM64</Platform>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds System.Windows.Forms + System.Drawing as implicit
         global usings. System.Windows.Forms.Application then collides with
         System.Windows.Application in every WPF file. Drop it; the `Forms`
         alias covers the handful of WinForms types we actually use.
         System.Drawing stays: vendored AsusMouse.cs relies on it for Color. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />

    <!-- The WinForms+WPF implicit-using set omits System.IO, which the vendored
         HID code needs for IOException. Add it globally rather than editing
         four files. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Button-map artwork (line renders of the Spatha, top and left side). -->
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\SpathaRE.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only third-party dependency. Fully managed; P/Invokes hid.dll and
         setupapi.dll, no native payload, so it loads fine under ARM64. -->
    <PackageReference Include="HidSharpCore" Version="1.3.0" />
  </ItemGroup>

</Project>
