<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the original-Spatha protocol and device code against a simulated
       mouse. Pure .NET, so it also runs on Linux/macOS: dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\SpathaRE\Core\Logger.cs" Link="Shared\Logger.cs" />
    <Compile Include="..\SpathaRE\Core\AppConfig.cs" Link="Shared\AppConfig.cs" />
    <Compile Include="..\SpathaRE\Core\Devices\IMouseDevice.cs" Link="Shared\IMouseDevice.cs" />
    <Compile Include="..\SpathaRE\Core\Devices\Buttons.cs" Link="Shared\Buttons.cs" />
    <Compile Include="..\SpathaRE\Core\Devices\PortableProfile.cs" Link="Shared\PortableProfile.cs" />
    <Compile Include="..\SpathaRE\Core\Spatha\SpathaCodec.cs" Link="Shared\SpathaCodec.cs" />
    <Compile Include="..\SpathaRE\Core\Spatha\SpathaProtocol.cs" Link="Shared\SpathaProtocol.cs" />
    <Compile Include="..\SpathaRE\Core\Spatha\SpathaDevice.cs" Link="Shared\SpathaDevice.cs" />
    <Compile Include="..\SpathaRE\Core\Spatha\WinHidTransport.cs" Link="Shared\WinHidTransport.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HidSharpCore" Version="1.3.0" />
  </ItemGroup>
</Project>
