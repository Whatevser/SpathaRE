<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the original-Spatha protocol and device code against a simulated
       mouse. Pure .NET, so it also runs on Linux/macOS: dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\SpathaRE\Core\Logger.cs" Link="App\Logger.cs" />
    <Compile Include="..\SpathaRE\Core\AppConfig.cs" Link="App\AppConfig.cs" />
    <Compile Include="..\SpathaRE\Core\Shared\*.cs" LinkBase="Shared" />
    <Compile Include="..\SpathaRE\Core\SpathaL701\*.cs" LinkBase="SpathaL701" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HidSharpCore" Version="1.3.0" />
  </ItemGroup>
</Project>
